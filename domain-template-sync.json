{
  "version": 1,
  "schema": "agent-domain-template-sync.v1",
  "description": "L2 agent-system-template -> L3 agent derived project sync manifest. Layout: root-level domain/ coverage-sync area (mother template v1.75.0 three-layer layout). Project facts are never overwritten by default.",
  "source": {
    "name": "agent-system-template",
    "layer": "L2",
    "version_file": "VERSION"
  },
  "target": {
    "type": "agent-derived-project",
    "layer": "L3"
  },
  "policy": {
    "requires_l1_sync_first": true,
    "default_mode": "copy-if-missing",
    "overwrite_project_facts": false,
    "self_check_strength": "advisory-first",
    "commit_message": "sync agent domain template {version} from agent-system-template"
  },
  "common_passthrough": {
    "source_manifest": "template-sync.json",
    "target_paths": "same-path",
    "handled_by": "L1 methodology is absorbed by the L2 repo and delivered whole-repo at creation; this manifest only tracks the root-level domain/ coverage area plus domain-owned scripts."
  },
  "files": [
    {
      "source": "domain-template-sync.json",
      "target": "domain-template-sync.json",
      "kind": "domain-sync-manifest",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/README.md",
      "target": "domain/README.md",
      "kind": "domain-reference",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/layer-map.md",
      "target": "domain/layer-map.md",
      "kind": "domain-reference",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/scenarios.md",
      "target": "domain/scenarios.md",
      "kind": "domain-playbook",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/scaffold/agent-system-checklist.md",
      "target": "domain/scaffold/agent-system-checklist.md",
      "kind": "domain-reference",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/profiles/single-agent.md",
      "target": "domain/standards/profiles/single-agent.md",
      "kind": "domain-profile",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/profiles/multi-agent.md",
      "target": "domain/standards/profiles/multi-agent.md",
      "kind": "domain-profile-stub",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/doc-standards/agent-architecture.md",
      "target": "domain/standards/doc-standards/agent-architecture.md",
      "kind": "domain-doc-standard",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/doc-standards/agent-tool-permission-model.md",
      "target": "domain/standards/doc-standards/agent-tool-permission-model.md",
      "kind": "domain-doc-standard",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/doc-standards/agent-memory-and-state.md",
      "target": "domain/standards/doc-standards/agent-memory-and-state.md",
      "kind": "domain-doc-standard",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/doc-standards/agent-trace-and-replay.md",
      "target": "domain/standards/doc-standards/agent-trace-and-replay.md",
      "kind": "domain-doc-standard",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/doc-standards/agent-hitl-and-safety.md",
      "target": "domain/standards/doc-standards/agent-hitl-and-safety.md",
      "kind": "domain-doc-standard",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/standards/doc-standards/agent-eval-plan.md",
      "target": "domain/standards/doc-standards/agent-eval-plan.md",
      "kind": "domain-doc-standard",
      "mode": "overwrite-domain-owned"
    },
    {
      "source": "domain/scaffold/docs/design/agent-architecture.md",
      "target": "docs/design/agent-architecture.md",
      "kind": "project-doc-skeleton",
      "mode": "copy-if-missing"
    },
    {
      "source": "domain/scaffold/docs/design/tool-permission-model.md",
      "target": "docs/design/tool-permission-model.md",
      "kind": "project-doc-skeleton",
      "mode": "copy-if-missing"
    },
    {
      "source": "domain/scaffold/docs/design/memory-and-state.md",
      "target": "docs/design/memory-and-state.md",
      "kind": "project-doc-skeleton",
      "mode": "copy-if-missing"
    },
    {
      "source": "domain/scaffold/docs/design/trace-and-replay.md",
      "target": "docs/design/trace-and-replay.md",
      "kind": "project-doc-skeleton",
      "mode": "copy-if-missing"
    },
    {
      "source": "domain/scaffold/docs/design/hitl-and-safety.md",
      "target": "docs/design/hitl-and-safety.md",
      "kind": "project-doc-skeleton",
      "mode": "copy-if-missing"
    },
    {
      "source": "domain/scaffold/docs/research/agent-eval-plan.md",
      "target": "docs/research/agent-eval-plan.md",
      "kind": "project-doc-skeleton",
      "mode": "copy-if-missing"
    },
    {
      "source": "scripts/sync-domain-template.ps1",
